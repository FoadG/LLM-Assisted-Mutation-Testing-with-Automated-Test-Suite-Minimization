    "logical_operators": false,
    "relational_operators": true
  },
  "optimizer": {
    "feedback_failed_inputs_in_prompt": 3,
    "feedback_max_mutants_per_round": 10,
    "feedback_max_new_tests_per_mutant": 2,
    "feedback_max_rounds": 3,
    "target_score": 90
  },
